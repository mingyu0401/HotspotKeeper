<Window x:Class="HotspotKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotspotKeeper · 热点守护"
        Width="580" Height="780" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,16,8">
            <StackPanel>

                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                    <Border Background="{DynamicResource Accent}" CornerRadius="8" Width="34" Height="34">
                        <TextBlock Text="📶" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="HotspotKeeper" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="个人热点守护 · Windows 11" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 状态卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="热点守护" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="热点状态" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="TxtState" Text="—" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="连接设备" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="TxtClients" Text="—" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="上次检测" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="TxtLastCheck" Text="—" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="守护" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="TxtDaemon" Text="未运行" Style="{StaticResource StatValue}"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,0,0,10" Style="{StaticResource Hint}"
                                   Text="启动守护后会立即打开 WiFi 与个人热点，并每 60 秒检测一次连接设备数；设备数为 0 时自动关闭并重新开启热点。"/>
                        <WrapPanel>
                            <Button x:Name="BtnStartDaemon" Content="▶ 启动守护" Width="120" Margin="0,0,8,0"
                                    Style="{DynamicResource AccentButton}" Click="BtnStartDaemon_Click"/>
                            <Button x:Name="BtnStopDaemon" Content="⏹ 停止守护" Width="120" Margin="0,0,8,0"
                                    IsEnabled="False" Click="BtnStopDaemon_Click"/>
                            <Button x:Name="BtnCheckNow" Content="立即检测一次" Width="120"
                                    Click="BtnCheckNow_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 一键切换卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="网络一键切换" Style="{StaticResource CardTitle}"/>
                        <TextBlock Margin="0,0,0,10" Style="{StaticResource Hint}"
                                   Text="切换模式：关闭有线网卡 → 打开 WiFi → 启动 Clash for Windows（守护会同时暂停，避免热点干扰）。&#10;恢复模式：关闭 Clash for Windows → 重新启用有线网卡。"/>
                        <WrapPanel>
                            <Button x:Name="BtnToWiredClash" Content="切换到：WiFi + Clash（断开有线）"
                                    MinWidth="240" Margin="0,0,8,0" Click="BtnToWiredClash_Click"/>
                            <Button x:Name="BtnRestore" Content="恢复：关闭 Clash + 启用有线"
                                    MinWidth="220" Click="BtnRestore_Click"/>
                        </WrapPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}" Foreground="{DynamicResource WarnFg}"
                                   Text="⚠ 切换会短暂断网，请确认 WiFi 可用后再操作。此功能未经实测。"/>
                    </StackPanel>
                </Border>

                <!-- 设置卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkAutoStart" Content="开机自启动（任务计划，最高权限）"
                                      VerticalAlignment="Center" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAutoDaemon" Content="打开软件时自动启动守护（开 WiFi + 热点）"
                                  Margin="0,0,0,12" Checked="ChkAutoDaemon_Changed" Unchecked="ChkAutoDaemon_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主题" VerticalAlignment="Center" Width="70"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <ComboBox Grid.Column="1" x:Name="CmbTheme" HorizontalAlignment="Left"
                                      SelectionChanged="CmbTheme_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="auto"/>
                                <ComboBoxItem Content="浅色" Tag="light"/>
                                <ComboBoxItem Content="深色" Tag="dark"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Clash 路径" VerticalAlignment="Center" Width="70"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <TextBox Grid.Column="1" x:Name="TxtClashPath" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" LostFocus="TxtClashPath_LostFocus"
                                     ToolTip="留空则自动在常见安装位置查找 Clash for Windows.exe"/>
                            <Button Grid.Column="2" x:Name="BtnBrowseClash" Content="浏览…" Click="BtnBrowseClash_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 关于卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="64" Height="64" Margin="0,0,14,0">
                            <Ellipse Width="64" Height="64" Fill="{DynamicResource Accent}"/>
                            <Ellipse Width="62" Height="62">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarBrush" ImageSource="Assets/avatar.jpg"
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="64" Height="64" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                     Fill="Transparent"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HotspotKeeper v1.0.0" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0">
                                作者：明雨（MingYu）
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0">
                                <Hyperlink x:Name="LnkGitHub" NavigateUri="https://github.com/mingyu0401"
                                           Foreground="{DynamicResource LinkFg}"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    github.com/mingyu0401
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="本软件未经全面测试，不保证一定可用。"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
